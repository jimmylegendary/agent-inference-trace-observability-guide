{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/input-trace.schema.json",
  "title": "Agent Inference Input Trace",
  "type": "object",
  "required": [
    "trace_id",
    "openclaw_turn_id",
    "openclaw_llm_call_id",
    "model",
    "timing_ms",
    "tokens"
  ],
  "properties": {
    "trace_id": { "type": "string" },
    "openclaw_turn_id": { "type": "string" },
    "openclaw_llm_call_id": { "type": "string" },
    "x_request_id": { "type": "string" },
    "litellm_call_id": { "type": "string" },
    "vllm_request_id": { "type": "string" },
    "model": { "type": "string" },
    "raw_content": {
      "type": "object",
      "description": "Owned by OpenClaw only.",
      "properties": {
        "system_prompt": { "type": "string" },
        "input_messages": { "type": "array", "items": { "type": "object" } },
        "tool_inputs": { "type": "array", "items": { "type": "object" } },
        "tool_outputs": { "type": "array", "items": { "type": "object" } },
        "completion": { "type": "string" }
      },
      "additionalProperties": true
    },
    "route": {
      "type": "object",
      "properties": {
        "litellm_model_group": { "type": "string" },
        "litellm_provider": { "type": "string" },
        "vllm_instance": { "type": "string" },
        "lmcache_instance": { "type": "string" }
      },
      "additionalProperties": true
    },
    "timing_ms": {
      "type": "object",
      "properties": {
        "openclaw_to_litellm": { "type": "number" },
        "litellm_to_vllm": { "type": "number" },
        "queue": { "type": "number" },
        "time_to_first_token": { "type": "number" },
        "end_to_end": { "type": "number" }
      },
      "additionalProperties": true
    },
    "tokens": {
      "type": "object",
      "properties": {
        "prompt": { "type": "integer" },
        "prompt_cached": { "type": "integer" },
        "generated": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "kv_cache": {
      "type": "object",
      "properties": {
        "prefix_hit_tokens": { "type": "integer" },
        "lookup_hit_rate": { "type": "number" },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "block_hash": { "type": "string" },
              "parent_block_hash": { "type": "string" },
              "operation": { "type": "string" },
              "tier": { "type": "string" },
              "medium": { "type": "string" },
              "tokens": { "type": "integer" },
              "latency_ms": { "type": "number" },
              "hit": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "agent_sequence": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "otel_span_ids": { "type": "array", "items": { "type": "string" } },
        "metric_windows": { "type": "array", "items": { "type": "object" } },
        "kv_event_ids": { "type": "array", "items": { "type": "string" } },
        "lmcache_trace_files": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
