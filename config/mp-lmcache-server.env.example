# LMCache MP server example.
# Start the LMCache server before vLLM workers.

# Minimal local command:
# lmcache server \
#   --host 0.0.0.0 \
#   --port 5555 \
#   --http-port 8080 \
#   --l1-size-gb 100 \
#   --eviction-policy LRU

LMCACHE_MP_HOST=0.0.0.0
LMCACHE_MP_PORT=5555
LMCACHE_MP_HTTP_PORT=8080
LMCACHE_MP_L1_SIZE_GB=100
LMCACHE_MP_EVICTION_POLICY=LRU

# The MP server ZMQ port is connector/server communication.
# It is not the same as vLLM --kv-events-config ZMQ event publication.
