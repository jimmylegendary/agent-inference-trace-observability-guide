# LMCache MP server example.
# Start the LMCache server before vLLM workers.

# Minimal local command:
# lmcache server \
#   --host 0.0.0.0 \
#   --port 5555 \
#   --prometheus-port 9090 \
#   --l1-size-gb 100 \
#   --eviction-policy LRU \
#   --enable-tracing \
#   --otlp-endpoint http://otel-collector:4317 \
#   --trace-level storage \
#   --trace-output /var/log/lmcache/lmcache-storage.lct

LMCACHE_MP_HOST=0.0.0.0
LMCACHE_MP_PORT=5555
LMCACHE_MP_PROMETHEUS_PORT=9090
LMCACHE_MP_L1_SIZE_GB=100
LMCACHE_MP_EVICTION_POLICY=LRU
LMCACHE_MP_ENABLE_TRACING=true
LMCACHE_MP_OTLP_ENDPOINT=http://otel-collector:4317
LMCACHE_MP_TRACE_LEVEL=storage
LMCACHE_MP_TRACE_OUTPUT=/var/log/lmcache/lmcache-storage.lct

# The MP server ZMQ port is connector/server communication.
# It is not the same as vLLM --kv-events-config ZMQ event publication.
