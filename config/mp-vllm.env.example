# MP vLLM example using LMCacheMPConnector.
# Convert these to the launcher, Helm chart, systemd unit, or container args.

# Example:
# vllm serve <model> \
#   --kv-transfer-config '{"kv_connector":"LMCacheMPConnector","kv_role":"kv_both","kv_connector_extra_config":{"lmcache.mp.host":"lmcache-server","lmcache.mp.port":5555,"lmcache.mp.mq_timeout":30,"lmcache.mp.heartbeat_interval":10}}' \
#   --otlp-traces-endpoint http://otel-collector:4318/v1/traces \
#   --enable-request-id-headers \
#   --disable-log-requests

# Notes:
# - Use this as the production-oriented path.
# - Validate MP metrics/tracing separately from vLLM --kv-events-config.
# - Current vLLM source shows LMCacheMPConnector.take_events() returns an empty iterable.
#   Do not assume vLLM KV event ZMQ publication works in MP mode without testing.
