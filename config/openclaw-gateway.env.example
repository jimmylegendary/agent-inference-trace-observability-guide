# OpenClaw gateway process environment.
# Set these in the actual gateway service/container, not only in an interactive shell.

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=openclaw-gateway

# Required for OpenClaw observability plugin Traceloop/OpenLLMetry preload.
NODE_OPTIONS=--import /opt/openclaw-observability-plugin/instrumentation/preload.mjs

# OpenClaw owns raw content capture in this design.
OPENCLAW_OTEL_CONTENT_POLICY={"inputMessages":true,"outputMessages":true,"systemPrompt":true,"toolInputs":true,"toolOutputs":true}

# Keep LiteLLM raw prompt capture disabled in the LiteLLM process.
# Do not set LiteLLM GenAI content capture globally on shared hosts.
