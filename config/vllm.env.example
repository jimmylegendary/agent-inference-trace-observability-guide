# vLLM server flags/environment.
# Convert these to your launcher, Helm chart, systemd unit, or container args.

OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_SERVICE_NAME=vllm-server

# Example serve args:
# vllm serve <model> \
#   --otlp-traces-endpoint http://otel-collector:4318/v1/traces \
#   --collect-detailed-traces model,worker \
#   --enable-request-id-headers \
#   --enable-prefix-caching \
#   --kv-cache-metrics \
#   --kv-cache-metrics-sample 0.01 \
#   --kv-events-config '{"enable_kv_cache_events":"True","publisher":"zmq","topic":"kv-events","endpoint":"tcp://*:5557"}'

# Notes:
# - Detailed traces add overhead. Start with model,worker and benchmark.
# - Do not rely on vLLM OTel alone for full tier-level cache trace.
# - Use traceparent/tracestate propagation from LiteLLM to join with upstream spans.
