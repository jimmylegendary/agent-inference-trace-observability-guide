# Non-MP vLLM example using LMCacheConnectorV1.
# Convert these to the launcher, Helm chart, systemd unit, or container args.

LMCACHE_CONFIG_FILE=/etc/lmcache/non-mp-lmcache.yaml

# Example:
# vllm serve <model> \
#   --kv-transfer-config '{"kv_connector":"LMCacheConnectorV1","kv_role":"kv_both"}' \
#   --otlp-traces-endpoint http://otel-collector:4318/v1/traces \
#   --enable-request-id-headers \
#   --disable-log-requests \
#   --no-enable-prefix-caching \
#   --kv-events-config '{"enable_kv_cache_events":"True","publisher":"zmq","topic":"kv-events","endpoint":"tcp://*:5557"}'

# Notes:
# - This path is the direct vLLM KV events ZMQ validation path.
# - Start with vLLM prefix caching disabled unless a target recipe explicitly supports combining it with LMCache.
# - Do not use this as the final production topology if shared cache across processes is required.
